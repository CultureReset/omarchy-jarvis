[Unit]
Description=Jarvis session runner (Ghost Platform)
After=network.target

[Service]
Type=simple
Environment=GHOST_CONFIG=/etc/ghost/config.json
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/share/jarvis/venv/bin/python %h/.local/share/jarvis/jarvis-session.py --trigger remote
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
